              "raw": "{\n  \"name\": \"Heavy Duty Gasket\",\n  \"sku\": \"HD-GASKET-01\",\n  \"category\": \"Hardware\",\n  \"unitPrice\": 45.5,\n  \"currentStock\": 80,\n  \"minStockAlert\": 15,\n  \"location\": \"Warehouse A - Shelf 5\"\n}"
