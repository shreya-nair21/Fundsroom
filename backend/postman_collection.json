            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/challans?page=1&limit=10&search=&status=",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "challans"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "search",
                  "value": ""
                },
                {
                  "key": "status",
                  "value": ""
                }
              ]
            },
            "description": "Lists all sales challans."
          }
        },
        {
          "name": "Get Challan By ID",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/challans/1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "challans",
                "1"
              ]
            },
            "description": "Fetches details of a specific challan including customer profile, snapshot records, and total totals."
          }
        },
        {
          "name": "Create Challan",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": 1,\n  \"status\": \"DRAFT\",\n  \"products\": [\n    {\n      \"productId\": 1,\n      \"quantityOrdered\": 5\n    },\n    {\n      \"productId\": 2,\n      \"quantityOrdered\": 2\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/challans",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "challans"
              ]
            },
            "description": "Creates a new Sales Challan. If status is `CONFIRMED`, it validates stock levels (returns 400 if insufficient) and decrements stock atomically, logging `OUT` movements. Requires roles: ADMIN or SALES."
          }
        },
        {
          "name": "Update Challan Status",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"CONFIRMED\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/challans/1/status",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "challans",
                "1",
                "status"
              ]
            },
            "description": "Performs status transitions:\n- DRAFT -> CONFIRMED (validates and decrements stock, logs OUT)\n- CONFIRMED -> CANCELLED (restocks and logs IN)\n- DRAFT -> CANCELLED (no stock change)\nRequires roles: ADMIN, ACCOUNTS, or SALES."
          }
        }
      ]
